<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CookyPresentation.ViewModels;assembly=CookyPresentation"
             xmlns:designPreviews="clr-namespace:CookyAvaloniaApp.DesignPreviews"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CookyAvaloniaApp.Views.RecipeItemView"
             x:DataType="viewModels:RecipeItem">
    <Design.DataContext>
        <designPreviews:RecipeItemPreview/>
    </Design.DataContext>
    <StackPanel Orientation="Vertical">
        <TextBlock Text="{Binding Title}"/>
        <TextBlock Text="{Binding Created}"/>
    </StackPanel>
</UserControl>