<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CookyPresentation.ViewModels;assembly=CookyPresentation"
             xmlns:designPreviews="clr-namespace:CookyAvaloniaApp.DesignPreviews"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="CookyAvaloniaApp.Views.RecipeItemView"
             x:DataType="viewModels:RecipeItem">
    <Design.DataContext>
        <designPreviews:RecipeItemPreview/>
    </Design.DataContext>
    <Grid ColumnDefinitions="*, Auto">
        <StackPanel Orientation="Vertical" Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"/>
            <TextBlock Text="{Binding Created}"/>
        </StackPanel>
        <Button Content="{Binding OpenLabel}" 
                Command="{Binding OpenCommand}" 
                CommandParameter="{Binding}" 
                Grid.Column="1" Margin="10"/>
    </Grid>
</UserControl>