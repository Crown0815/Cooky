<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CookyPresentation.ViewModels;assembly=CookyPresentation"
             xmlns:designPreviews="clr-namespace:CookyAvaloniaApp.DesignPreviews"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CookyAvaloniaApp.Views.RecipesOverviewView"
             x:DataType="viewModels:RecipesOverview">
    <Design.DataContext>
        <designPreviews:RecipesOverviewPreview/>
    </Design.DataContext>
    <StackPanel>
        <Button Command="{Binding NewRecipeCommand}" Content="{Binding NewRecipeLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <ListBox ItemsSource="{Binding Recipes}"/>
    </StackPanel>
</UserControl>