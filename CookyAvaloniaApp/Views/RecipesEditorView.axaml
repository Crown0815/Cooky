<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:designPreviews="clr-namespace:CookyAvaloniaApp.DesignPreviews"
             xmlns:viewModels="clr-namespace:CookyPresentation.ViewModels;assembly=CookyPresentation"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CookyAvaloniaApp.Views.RecipesEditorView"
             x:DataType="viewModels:RecipeEditor">
    <Design.DataContext>
        <designPreviews:RecipeEditorPreview/>
    </Design.DataContext>
    <StackPanel>
        <SelectableTextBlock Text="{Binding Title}"/>
        <TextBlock Text="Ingredients"/>
        <ContentControl Content="{Binding Ingredients}"/>
        <TextBlock Text="Instructions"/>
        <TextBox Text="{Binding Instructions}"/>
    </StackPanel>
</UserControl>